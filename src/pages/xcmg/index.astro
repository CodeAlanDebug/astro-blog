---
// Digital business card — opened by scanning the QR code (xcmg.alan.one).
// Standalone page: no blog header/footer/global CSS, system fonts only, so it
// renders fast on a phone on trade-show Wi-Fi. Edit details in
// src/data/xcmgCard.ts.
import { brand, card, fullName } from "../../data/xcmgCard";

export const prerender = true;

const pageUrl = new URL(card.path, Astro.site);
const initials = `${card.givenName[0]}${card.familyName[0]}`;
const title = `${fullName} · ${card.title}, ${card.org}`;
const description = `${card.title} at ${card.org}. Tap to save my contact details.`;
const linkedinHandle = card.linkedin.replace(/^https?:\/\/(www\.)?/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Reached by QR code, not search: keep the phone number out of indexes. -->
    <meta name="robots" content="noindex,nofollow" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content={brand.navy} />
    <meta name="format-detection" content="telephone=no" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={`${fullName} — ${card.org}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="profile:first_name" content={card.givenName} />
    <meta property="profile:last_name" content={card.familyName} />
  </head>
  <body>
    <div class="layout">
      <main class="card">
        <header class="hero">
          <span class="wordmark">{card.org}</span>
        </header>

        <section class="identity">
          <div class="avatar" aria-hidden="true">
            {initials}
          </div>
          <h1>{fullName}</h1>
          <p class="role">{card.title}</p>
          <p class="org">{card.org}</p>
        </section>

        <div class="primary">
          <a class="btn btn-primary" href={card.vcfPath}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M19 8v6M22 11h-6"></path>
            </svg>
            Save contact
          </a>
          <p class="hint" id="wechat-hint" hidden>
            WeChat can't save contacts. Tap <strong>···</strong> (top right) →
            <strong>Open in Browser</strong>.<br />
            <span lang="zh-CN">
              微信内无法保存联系人，请点击右上角 ··· →「在浏览器打开」。
            </span>
          </p>
        </div>

        <ul class="rows">
          {card.phone && (
            <li>
              <a href={`tel:${card.phone}`}>
                <span class="icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
                  </svg>
                </span>
                <span class="text">
                  <span class="label">Mobile</span>
                  <span class="value">{card.phoneDisplay || card.phone}</span>
                </span>
                <svg class="chev" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </a>
            </li>
          )}
          <li>
            <a href={`mailto:${card.email}`}>
              <span class="icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
              </span>
              <span class="text">
                <span class="label">Email</span>
                <span class="value">{card.email}</span>
              </span>
              <svg class="chev" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m9 18 6-6-6-6"></path>
              </svg>
            </a>
          </li>
          <li>
            <a href={card.linkedin} rel="noopener">
              <span class="icon">
                <svg viewBox="0 0 24 24" aria-hidden="true" class="filled">
                  <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"></path>
                </svg>
              </span>
              <span class="text">
                <span class="label">LinkedIn</span>
                <span class="value">{linkedinHandle}</span>
              </span>
              <svg class="chev" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m9 18 6-6-6-6"></path>
              </svg>
            </a>
          </li>
        </ul>

        <div class="secondary">
          <button class="btn btn-ghost" id="share" type="button">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
              <path d="m16 6-4-4-4 4"></path>
              <path d="M12 2v13"></path>
            </svg>
            <span id="share-label">Share this card</span>
          </button>
          <a class="btn btn-ghost" href={`${card.path}qr/`}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7" rx="1"></rect>
              <rect x="14" y="3" width="7" height="7" rx="1"></rect>
              <rect x="3" y="14" width="7" height="7" rx="1"></rect>
              <path d="M14 14h3v3h-3zM20 14v.01M14 20h.01M17 17h4v4h-4"></path>
            </svg>
            Show QR code
          </a>
        </div>
      </main>
    </div>

    <script is:inline>
      (function () {
        // WeChat's in-app browser blocks .vcf downloads — tell the visitor
        // how to escape to the system browser. Common for China contacts.
        if (/MicroMessenger/i.test(navigator.userAgent)) {
          document.getElementById("wechat-hint").hidden = false;
        }

        var btn = document.getElementById("share");
        var label = document.getElementById("share-label");
        var url = location.origin + location.pathname;

        btn.addEventListener("click", function () {
          if (navigator.share) {
            navigator
              .share({ title: document.title, url: url })
              .catch(function () {});
            return;
          }
          if (navigator.clipboard) {
            navigator.clipboard.writeText(url).then(function () {
              label.textContent = "Link copied";
              setTimeout(function () {
                label.textContent = "Share this card";
              }, 2000);
            });
          }
        });
      })();
    </script>

    <style
      is:global
      define:vars={{
        navy: brand.navy,
        navyDeep: brand.navyDeep,
        blueBright: brand.blueBright,
      }}
    >
      :root {
        --bg: #eef1f6;
        --card: #ffffff;
        --ink: #121826;
        --muted: #556070;
        --line: #e3e7ee;
        --row: #f3f5f9;
        --icon-ink: var(--navy);
        --btn: var(--navy);
        --on-btn: #ffffff;
        --ring: var(--blueBright);
        --shadow: 0 1px 2px rgb(0 20 60 / 0.06), 0 12px 32px rgb(0 20 60 / 0.1);
        color-scheme: light dark;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #080b12;
          --card: #111621;
          --ink: #eef1f6;
          --muted: #9aa5b8;
          --line: #232a38;
          --row: #18202e;
          --icon-ink: #8fb4ee;
          /* Corporate navy disappears on a dark page; lift it for buttons. */
          --btn: var(--blueBright);
          --shadow: 0 0 0 1px #1e2533;
        }
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        margin: 0;
        min-height: 100dvh;
        background: var(--bg);
        color: var(--ink);
        font-family:
          system-ui,
          -apple-system,
          "Segoe UI",
          Roboto,
          "Helvetica Neue",
          "PingFang SC",
          "Microsoft YaHei",
          "Noto Sans CJK SC",
          sans-serif;
        line-height: 1.4;
        -webkit-font-smoothing: antialiased;
        -webkit-tap-highlight-color: transparent;
      }

      .layout {
        min-height: 100dvh;
        display: flex;
        justify-content: center;
        align-items: flex-start;
      }

      /* ---------- Card (mobile-first: fills the screen) ---------- */
      .card {
        width: 100%;
        max-width: 440px;
        min-height: 100dvh;
        background: var(--card);
        padding-bottom: calc(24px + env(safe-area-inset-bottom));
      }

      .hero {
        position: relative;
        height: 132px;
        background: linear-gradient(135deg, var(--navy), var(--navyDeep));
        padding: calc(18px + env(safe-area-inset-top))
          max(20px, env(safe-area-inset-right)) 0
          max(20px, env(safe-area-inset-left));
        overflow: hidden;
      }

      /* Subtle diagonal line texture, fading in from the right. */
      .hero::before {
        content: "";
        position: absolute;
        right: -40px;
        top: -10px;
        width: 240px;
        height: 170px;
        background: repeating-linear-gradient(
          -45deg,
          rgb(255 255 255 / 0.07) 0 2px,
          transparent 2px 14px
        );
        mask-image: linear-gradient(to left, #000 30%, transparent);
        -webkit-mask-image: linear-gradient(to left, #000 30%, transparent);
      }

      .wordmark {
        position: relative;
        color: #fff;
        font-weight: 800;
        font-size: 20px;
        letter-spacing: 0.18em;
      }

      .identity {
        padding: 0 24px;
        margin-top: -44px;
        position: relative;
      }

      .avatar {
        width: 88px;
        height: 88px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: #fff;
        color: var(--navy);
        font-weight: 800;
        font-size: 30px;
        letter-spacing: 0.02em;
        border: 4px solid var(--card);
        box-shadow: 0 2px 10px rgb(0 20 60 / 0.15);
        margin-bottom: 14px;
      }

      h1 {
        margin: 0;
        font-size: 28px;
        line-height: 1.15;
        font-weight: 750;
        letter-spacing: -0.01em;
      }

      .role {
        margin: 6px 0 0;
        font-size: 17px;
        color: var(--ink);
      }

      .org {
        margin: 2px 0 0;
        font-size: 15px;
        color: var(--muted);
        font-weight: 600;
        letter-spacing: 0.04em;
      }

      /* ---------- Buttons ---------- */
      .primary,
      .secondary {
        padding: 0 20px;
      }

      .primary {
        margin-top: 24px;
      }

      .secondary {
        display: grid;
        gap: 10px;
      }

      .btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        min-height: 54px;
        border-radius: 14px;
        font: inherit;
        font-size: 17px;
        font-weight: 650;
        text-decoration: none;
        cursor: pointer;
        border: 0;
        transition:
          transform 0.08s ease,
          filter 0.15s ease,
          background 0.15s ease;
      }

      .btn:active {
        transform: scale(0.985);
      }

      .btn svg {
        width: 22px;
        height: 22px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .btn-primary {
        background: var(--btn);
        color: var(--on-btn);
        box-shadow: 0 6px 16px rgb(0 50 119 / 0.25);
      }

      .btn-primary:hover {
        filter: brightness(1.12);
      }

      .btn-ghost {
        background: transparent;
        color: var(--ink);
        border: 1.5px solid var(--line);
      }

      .btn-ghost:hover {
        background: var(--row);
      }

      .btn:focus-visible,
      .rows a:focus-visible {
        outline: 3px solid var(--ring);
        outline-offset: 2px;
      }

      .hint {
        margin: 12px 4px 0;
        padding: 12px 14px;
        border-radius: 12px;
        background: var(--row);
        color: var(--muted);
        font-size: 14px;
        line-height: 1.5;
      }

      .hint[hidden] {
        display: none;
      }

      /* ---------- Contact rows ---------- */
      .rows {
        list-style: none;
        margin: 20px 0;
        padding: 0 8px;
      }

      .rows li {
        margin: 0 12px;
      }

      .rows li + li {
        border-top: 1px solid var(--line);
      }

      .rows a {
        display: flex;
        align-items: center;
        gap: 14px;
        min-height: 68px;
        padding: 10px 4px;
        color: inherit;
        text-decoration: none;
        border-radius: 10px;
      }

      .rows a:hover {
        background: var(--row);
      }

      .icon {
        flex: none;
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: var(--row);
        color: var(--icon-ink);
      }

      .icon svg {
        width: 20px;
        height: 20px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .icon svg.filled {
        fill: currentColor;
        stroke: none;
      }

      .text {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
      }

      .label {
        font-size: 13px;
        color: var(--muted);
      }

      .value {
        font-size: 17px;
        overflow-wrap: anywhere;
      }

      .chev {
        flex: none;
        width: 18px;
        height: 18px;
        fill: none;
        stroke: var(--muted);
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      /* ---------- Desktop / tablet: floating card ---------- */
      @media (min-width: 720px) {
        .layout {
          align-items: center;
          padding: 48px 24px;
        }

        .card {
          min-height: 0;
          border-radius: 24px;
          overflow: hidden;
          box-shadow: var(--shadow);
          padding-bottom: 24px;
        }

        .hero {
          padding-top: 20px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .btn {
          transition: none;
        }
      }
    </style>
  </body>
</html>
