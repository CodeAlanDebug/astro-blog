---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import "../styles/home.css";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <div class="hero-content">
          <h1>👋 Hey, I'm Alan Zheng</h1>
          <p class="subtitle">
            Cloud, platform, and automation engineer. I build AWS
            infrastructure, CI/CD, and agentic-AI tooling for software that has
            to pass an audit — most recently at Philips in Eindhoven.
          </p>
          <div class="tech-stack">
            <span class="tech-badge">☁️ AWS &amp; Cloud Security</span>
            <span class="tech-badge">⚙️ Infrastructure as Code</span>
            <span class="tech-badge">🔁 CI/CD</span>
            <span class="tech-badge">🐍 Python &amp; Automation</span>
            <span class="tech-badge">🤖 MCP &amp; Agentic AI</span>
            <span class="tech-badge">🏥 Regulated Healthcare (QMS/PDLM)</span>
          </div>
        </div>
      </section>

      <div class="status-strip">
        <span class="status-item">📍 Eindhoven, Netherlands</span>
      </div>

      <section class="about-section">
        <div class="main-content">
          <h2>About Me</h2>
          <p>
            I work where cloud infrastructure meets software that has to be
            provably correct. At Philips that meant the platform's first AWS WAF
            delivered as infrastructure-as-code, CI/CD pipelines that hold up
            through a release, and design documentation that survives a PDLM/QMS
            audit.
          </p>
          <p>
            Alongside that I build with Claude, MCP servers, GitHub Copilot and
            n8n — and I've driven adoption of those workflows among senior
            colleagues, not just used them myself.
          </p>
        </div>
      </section>

      <section>
        <div class="main-content">
          <h2 class="section-title">Selected Work</h2>
          <div class="projects-grid">
            <div class="project-card">
              <h3>
                <span class="project-icon">🧭</span>
                IND Sponsor MCP
              </h3>
              <p>
                An MCP server that exposes the Dutch IND recognised-sponsor
                register to AI agents, so an assistant can answer "is this
                employer a recognised sponsor?" against the live register
                instead of guessing. TypeScript, published as a Model Context
                Protocol server.
              </p>
              <div class="project-tags">
                <span class="tag">TypeScript</span>
                <span class="tag">MCP</span>
                <span class="tag">Agentic AI</span>
                <span class="tag">Public data</span>
              </div>
              <a
                class="project-link"
                href="https://github.com/CodeAlanDebug/hsm-mcp"
                target="_blank"
                rel="noopener noreferrer">View source on GitHub →</a
              >
            </div>

            <div class="project-card">
              <h3>
                <span class="project-icon">📡</span>
                Offline-capable medical records for BATDOK
              </h3>
              <p>
                Extended BATDOK so electronic medical records stay available
                where the network doesn't: IPFS-backed peer-to-peer sharing via
                an Android plugin bridging Kotlin and Go over JNI, with a
                feasibility and security assessment for military-grade
                deployment. Built during my Philips internship.
              </p>
              <div class="project-tags">
                <span class="tag">Kotlin</span>
                <span class="tag">Go</span>
                <span class="tag">JNI</span>
                <span class="tag">IPFS</span>
                <span class="tag">Medical data</span>
                <span class="tag">Offline-first</span>
              </div>
              <a
                class="project-link"
                href="https://github.com/CodeAlanDebug/gomobile-cal"
                target="_blank"
                rel="noopener noreferrer">Related public code: gomobile-cal →</a
              >
            </div>

            <div class="project-card">
              <h3>
                <span class="project-icon">🛡️</span>
                AWS WAF and observability for a Philips platform
              </h3>
              <p>
                The platform's first WAF, delivered as infrastructure-as-code:
                OWASP Top 10 rules, IP filtering, DDoS mitigation and automated
                rule updates, with CloudWatch logging and alerting for the
                security signal. Delivered at Philips.
              </p>
              <div class="project-tags">
                <span class="tag">AWS</span>
                <span class="tag">WAF</span>
                <span class="tag">IaC</span>
                <span class="tag">CloudWatch</span>
                <span class="tag">Cloud security</span>
              </div>
              <p class="project-note">Enterprise work — no public code.</p>
            </div>

            <div class="project-card">
              <h3>
                <span class="project-icon">⚡</span>
                Self-hosted n8n on Fly.io
              </h3>
              <p>
                Deployment automation for a self-hosted n8n instance on Fly.io —
                reproducible automation infrastructure you own, rather than a
                SaaS tier.
              </p>
              <div class="project-tags">
                <span class="tag">Fly.io</span>
                <span class="tag">Docker</span>
                <span class="tag">Shell</span>
                <span class="tag">n8n</span>
                <span class="tag">Automation</span>
              </div>
              <a
                class="project-link"
                href="https://github.com/CodeAlanDebug/fly-n8n"
                target="_blank"
                rel="noopener noreferrer">View source on GitHub →</a
              >
            </div>
          </div>
          <p class="projects-footnote">
            This site: Astro 7 on Cloudflare Workers, with a Sveltia CMS and
            owner-only GitHub OAuth —
            <a
              href="https://github.com/CodeAlanDebug/astro-blog"
              target="_blank"
              rel="noopener noreferrer">source on GitHub</a
            >.
          </p>
        </div>
      </section>

      <section class="cta-section">
        <h2>Get in touch</h2>
        <p>
          Happy to talk about cloud security, CI/CD in regulated environments,
          or where agentic tooling actually holds up in production.
        </p>
        <div class="cta-actions">
          <a href="/contact" class="cta-button primary">Get In Touch</a>
          <a href="/cv" class="cta-button">Read My CV</a>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
